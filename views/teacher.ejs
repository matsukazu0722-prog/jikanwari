<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>先生用 | 授業入力システム</title>
  <style>
    /* 既存のModal & Formスタイルを継承 */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "Helvetica Neue", Arial, sans-serif; background-color: #f4f7f6; color: #333; padding: 20px; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
    .modal-box { background: #ffffff; width: 100%; max-width: 480px; padding: 24px; border-radius: 16px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15); }
    .modal-box h3 { margin-bottom: 16px; color: #2c3e50; font-size: 1.2rem; border-left: 4px solid #3498db; padding-left: 8px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 0.8rem; color: #7f8c8d; margin-bottom: 6px; font-weight: bold; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; outline: none; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
    .btn { padding: 10px 20px; border: none; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
    .btn-save { background: #3498db; color: #ffffff; }
  </style>
</head>
<body>

  <div class="modal-box">
    <h3>授業情報の入力（先生用）</h3>
    <form id="teacherForm">
      <div class="form-group">
        <label for="subjectName">授業名</label>
        <input type="text" id="subjectName" required placeholder="例：数学 I">
      </div>

      <div class="form-group">
        <label for="daySelect">曜日</label>
        <select id="daySelect" required>
          <option value="mon">月曜日</option>
          <option value="tue">火曜日</option>
          <option value="wed">水曜日</option>
          <option value="thu">木曜日</option>
          <option value="fri">金曜日</option>
        </select>
      </div>

      <div class="form-group">
        <label for="periodSelect">時限</label>
        <select id="periodSelect" required>
          <option value="1">1限 (09:05 - 09:55)</option>
          <option value="2">2限 (10:05 - 10:55)</option>
          <option value="3">3限 (11:05 - 11:55)</option>
          <option value="4">4限 (12:30 - 13:20)</option>
          <option value="5">5限 (13:30 - 14:20)</option>
          <option value="6">6限 (14:30 - 15:20)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="colorCategory">科目カラーカテゴリ</label>
        <select id="colorCategory" required>
          <option value="math">数学 (ブルー)</option>
          <option value="english">英語 (パープル)</option>
          <option value="science">理科 (グリーン)</option>
          <option value="society">社会 (オレンジ)</option>
          <option value="japanese">国語 (レッド)</option>
          <option value="info">情報 (グレー)</option>
        </select>
      </div>

      <div class="modal-actions">
        <button type="submit" class="btn btn-save">生徒の時間割へ登録</button>
      </div>
    </form>
  </div>

  <script>
    document.getElementById('teacherForm').addEventListener('submit', (e) => {
      e.preventDefault();

      // 入力データの取得
      const newLesson = {
        name: document.getElementById('subjectName').value,
        day: document.getElementById('daySelect').value,
        period: parseInt(document.getElementById('periodSelect').value, 10),
        colorClass: document.getElementById('colorCategory').value
      };

      // 既存データの読み込み & 追加
      const timetableData = JSON.parse(localStorage.getItem('timetableData') || '[]');
      
      // 同じ曜日・時限のデータがあれば上書き、無ければ追加
      const existingIndex = timetableData.findIndex(item => item.day === newLesson.day && item.period === newLesson.period);
      if (existingIndex !== -1) {
        timetableData[existingIndex] = newLesson;
      } else {
        timetableData.push(newLesson);
      }

      // localStorageへ保存
      localStorage.setItem('timetableData', JSON.stringify(timetableData));
      alert('生徒側の時間割へ反映しました！');
    });
  </script>
</body>
</html>