<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>授業入力</title>
    <style>
        /* Apple-inspired Minimalist Design System */
        :root {
            --bg-color: #f5f5f7;
            --card-bg: #ffffff;
            --text-primary: #1d1d1f;
            --text-secondary: #86868b;
            --accent: #0071e3;
            --border-color: #d2d2d7;
            --radius: 12px;
            --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-color);
            color: var(--text-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            width: 100%;
            max-width: 480px;
            background: var(--card-bg);
            padding: 40px;
            border-radius: var(--radius);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        header {
            margin-bottom: 32px;
            text-align: center;
        }

        h1 {
            font-size: 24px;
            font-weight: 600;
            letter-spacing: -0.5px;
            margin-bottom: 8px;
        }

        .subtitle {
            color: var(--text-secondary);
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        label {
            display: block;
            font-size: 12px;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        input[type="text"],
        input[type="time"],
        select,
        textarea {
            width: 100%;
            padding: 14px 16px;
            font-size: 16px;
            font-family: var(--font-family);
            background-color: var(--bg-color);
            border: 1px solid transparent;
            border-radius: var(--radius);
            color: var(--text-primary);
            transition: all 0.2s ease;
            outline: none;
        }

        /* Focus State */
        input:focus, select:focus, textarea:focus {
            border-color: var(--accent);
            background-color: var(--card-bg);
            box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.15);
        }

        /* Grid for Time and Room */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        textarea {
            resize: none;
            height: 100px;
        }

        .btn-submit {
            width: 100%;
            padding: 16px;
            font-size: 16px;
            font-weight: 500;
            color: #ffffff;
            background-color: var(--accent);
            border: none;
            border-radius: var(--radius);
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.1s ease;
            margin-top: 8px;
        }

        .btn-submit:hover {
            background-color: #0077ed;
        }

        .btn-submit:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>授業情報の入力</h1>
        <p class="subtitle">本日のスケジュールを編集します</p>
    </header>

    <form onsubmit="return false;"></form>
        <div class="form-group">
            <label for="class-name">授業名</label>
            <input type="text" id="class-name" placeholder="例: 現代の総合英語 II" required>
        </div>

        <div class="form-group">
            <label for="target-class">対象クラス</label>
            <select id="target-class" required>
                <option value="" disabled selected hidden>選択してください</option>
                <option value="1a">1年A組</option>
                <option value="1b">1年B組</option>
                <option value="2a">2年A組</option>
                <option value="2b">2年B組</option>
            </select>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="class-time">開始時刻</label>
                <input type="time" id="class-time" required>
            </div>
            <div class="form-group">
                <label for="room">教室</label>
                <input type="text" id="room" placeholder="例: 302号室">
            </div>
        </div>

        <div class="form-group">
            <label for="notes">今日のトピック・持参物</label>
            <textarea id="notes" placeholder="例: 教科書P.45〜 / 小テスト実施"></textarea>
        </div>

        <button type="submit" class="btn-submit">登録する</button>
    </form>
</div>

</body>
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
import { getFirestore, collection, addDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

// Firebaseの設定
const firebaseConfig = {
    projectId: "project-0fbf53f8-6457-44e1-a088"
};

// 初期化
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

// フォームが送信されたときの処理
document.querySelector('form').addEventListener('submit', async (e) => {
    e.preventDefault(); // 画面リロード防止

    // 画面に入力されたデータを集める
    const data = {
        className: document.getElementById('class-name').value,
        targetClass: document.getElementById('target-class').value,
        startTime: document.getElementById('class-time').value,
        room: document.getElementById('room').value,
        notes: document.getElementById('notes').value,
        createdAt: new Date()
    };

    try {
        // 直接Firestoreの「schedules」コレクションに保存
        await addDoc(collection(db, "schedules"), data);
        
        alert('🎉 データベース（Firestore）への登録に成功しました！');
        document.querySelector('form').reset(); // 入力欄をクリア

    } catch (error) {
        console.error('保存エラー:', error);
        alert('❌ 登録に失敗しました。Firestoreのルールを確認してください。');
    }
});
</script>
</html>