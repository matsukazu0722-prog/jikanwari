<!DOCTYPE html>
<html lang="ja">

<head>
  <!-- 先生側の画面 -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="css/sutudent.css">
  <title>カスタム時間割システム</title>
</head>

<body>

  <div class="timetable-container">
    <div class="header-area">
      <h2 id="timetableTitle">週間時間割（通常期）</h2>

      <div class="controls-wrapper">
        <div class="btn-group">
          <button class="action-toggle-btn" id="toggleEditBtn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4L18.5 2.5z"></path>
            </svg>
            <span>編集モード</span>
          </button>
          <button class="action-toggle-btn" id="toggleTestBtn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z">
              </path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>テスト期間</span>
          </button>
        </div>

        <div class="tool-btn-group">
          <button class="circle-tool-btn" id="openCalcBtn" title="電卓を開く">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
              <line x1="8" y1="6" x2="16" y2="6"></line>
              <line x1="16" y1="14" x2="16" y2="18"></line>
              <line x1="16" y1="10" x2="16" y2="10"></line>
              <line x1="12" y1="10" x2="12" y2="14"></line>
              <line x1="12" y1="18" x2="12" y2="18"></line>
              <line x1="8" y1="10" x2="8" y2="10"></line>
              <line x1="8" y1="14" x2="8" y2="14"></line>
              <line x1="8" y1="18" x2="8" y2="18"></line>
            </svg>
          </button>
          <button class="circle-tool-btn" id="openTimerBtn" title="ストップウォッチを開く">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </button>
          <button class="circle-tool-btn" id="openMessageBtn" title="先生にメッセージを送る">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </button>
          <a href="https://www.google.com/maps" target="_blank" class="circle-tool-btn" id="openMapBtn"
            title="Googleマップを開く">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
              <line x1="9" y1="3" x2="9" y2="18"></line>
              <line x1="15" y1="6" x2="15" y2="21"></line>
            </svg>
          </a>
          <a href="https://pokeguesser.net" target="_blank" class="circle-tool-btn" id="openGameBtn"
            title="PokeGuesserを開く">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <circle cx="12" cy="12" r="3" fill="white"></circle>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="subtitle" id="statusSubtitle">【通常モード】マスを押すと授業の詳細が見れます</div>

    <div class="table-wrapper">
      <table class="timetable">
        <thead>
          <tr>
            <th>時間</th>
            <th>月<br><span class="th-date" id="date-mon">--/--</span></th>
            <th>火<br><span class="th-date" id="date-tue">--/--</span></th>
            <th>水<br><span class="th-date" id="date-wed">--/--</span></th>
            <th>木<br><span class="th-date" id="date-thu">--/--</span></th>
            <th>金<br><span class="th-date" id="date-fri">--/--</span></th>
          </tr>
        </thead>
        <tbody id="timetableBody">
        </tbody>
      </table>
    </div>
  </div>

  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-box" id="modalBox"></div>
  </div>

  <script src="js/sutudent.js" type="module"></script>

</body>

</html>